generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String   
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}